apiVersion: 1

groups:
  - orgId: 1
    name: monad
    folder: Monad
    interval: 1m
    rules:
      - uid: service-down
        title: ServiceDown
        condition: C
        for: 1m
        noDataState: Alerting
        labels:
          severity: critical
        annotations:
          summary: Monad service is down
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 300
              to: 0
            model:
              refId: A
              expr: node_systemd_unit_state{name=~"{{ service_identifier }}\\.service|{{ execution_service_identifier }}\\.service", state="active"}
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              datasource:
                type: '__expr__'
                uid: '__expr__'
          - refId: C
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
              datasource:
                type: '__expr__'
                uid: '__expr__'

      - uid: disk-space-low
        title: DiskSpaceLow
        condition: C
        for: 5m
        noDataState: OK
        labels:
          severity: warning
        annotations:
          summary: "Disk usage above {{ alert_disk_threshold }}%"
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 300
              to: 0
            model:
              refId: A
              expr: (1 - node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}) * 100
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              datasource:
                type: '__expr__'
                uid: '__expr__'
          - refId: C
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [{{ alert_disk_threshold }}]
              datasource:
                type: '__expr__'
                uid: '__expr__'

      - uid: high-memory
        title: HighMemoryUsage
        condition: C
        for: 10m
        noDataState: OK
        labels:
          severity: warning
        annotations:
          summary: Memory usage above 90%
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              refId: A
              expr: (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              datasource:
                type: '__expr__'
                uid: '__expr__'
          - refId: C
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [90]
              datasource:
                type: '__expr__'
                uid: '__expr__'

      - uid: node-exporter-down
        title: NodeExporterDown
        condition: C
        for: 2m
        noDataState: Alerting
        labels:
          severity: critical
        annotations:
          summary: Node exporter is unreachable
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 300
              to: 0
            model:
              refId: A
              expr: up{job="node-exporter"}
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              datasource:
                type: '__expr__'
                uid: '__expr__'
          - refId: C
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
              datasource:
                type: '__expr__'
                uid: '__expr__'

      - uid: otel-collector-down
        title: OtelCollectorDown
        condition: C
        for: 2m
        noDataState: Alerting
        labels:
          severity: critical
        annotations:
          summary: OTEL collector is unreachable (monad metrics lost)
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 300
              to: 0
            model:
              refId: A
              expr: up{job="otel-monad"}
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              datasource:
                type: '__expr__'
                uid: '__expr__'
          - refId: C
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
              datasource:
                type: '__expr__'
                uid: '__expr__'

      - uid: voting-rate-low
        title: VotingRateLow
        condition: C
        for: 5m
        noDataState: OK
        labels:
          severity: critical
        annotations:
          summary: "Voting rate dropped below 80%"
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 300
              to: 0
            model:
              refId: A
              expr: monad_voting_rate_pct
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              datasource:
                type: '__expr__'
                uid: '__expr__'
          - refId: C
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [80]
              datasource:
                type: '__expr__'
                uid: '__expr__'

      - uid: node-out-of-sync
        title: NodeOutOfSync
        condition: C
        for: 5m
        noDataState: OK
        labels:
          severity: critical
        annotations:
          summary: Node is syncing (not fully synced)
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 300
              to: 0
            model:
              refId: A
              expr: monad_sync_status
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              datasource:
                type: '__expr__'
                uid: '__expr__'
          - refId: C
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
              datasource:
                type: '__expr__'
                uid: '__expr__'

      - uid: monad-version-outdated
        title: MonadVersionOutdated
        condition: C
        for: 30m
        noDataState: OK
        labels:
          severity: warning
        annotations:
          summary: "Monad node version is behind latest published release"
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              refId: A
              expr: monad_version_outdated
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              datasource:
                type: '__expr__'
                uid: '__expr__'
          - refId: C
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [0]
              datasource:
                type: '__expr__'
                uid: '__expr__'

      - uid: low-wallet-balance
        title: LowWalletBalance
        condition: C
        for: 10m
        noDataState: OK
        labels:
          severity: warning
        annotations:
          summary: Wallet balance below 1 MON
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              refId: A
              expr: monad_wallet_balance_mon
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              datasource:
                type: '__expr__'
                uid: '__expr__'
          - refId: C
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
              datasource:
                type: '__expr__'
                uid: '__expr__'

      - uid: panic-pattern-detected
        title: PanicPatternDetected
        condition: C
        for: 1m
        noDataState: OK
        labels:
          severity: critical
        annotations:
          summary: "Fatal consensus pattern in journal (high qc too far / block tree root / panicked)"
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 300
              to: 0
            model:
              refId: A
              expr: monad_consensus_panic_count
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              datasource:
                type: '__expr__'
                uid: '__expr__'
          - refId: C
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [0]
              datasource:
                type: '__expr__'
                uid: '__expr__'

      - uid: round-progression-stalled
        title: RoundProgressionStalled
        condition: C
        for: 5m
        noDataState: OK
        labels:
          severity: critical
        annotations:
          summary: "Consensus round has not advanced — likely peer isolation or stall"
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              refId: A
              expr: max_over_time(monad_consensus_round[{{ alert_round_stall_seconds }}s]) - min_over_time(monad_consensus_round[{{ alert_round_stall_seconds }}s])
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              datasource:
                type: '__expr__'
                uid: '__expr__'
          - refId: C
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
              datasource:
                type: '__expr__'
                uid: '__expr__'

      - uid: consensus-restart-loop
        title: ConsensusRestartLoop
        condition: C
        for: 2m
        noDataState: OK
        labels:
          severity: critical
        annotations:
          summary: "Consensus service restarting repeatedly — possible panic loop"
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              refId: A
              expr: delta(monad_consensus_nrestarts[10m])
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              datasource:
                type: '__expr__'
                uid: '__expr__'
          - refId: C
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [{{ alert_restart_loop_threshold }}]
              datasource:
                type: '__expr__'
                uid: '__expr__'

      - uid: mev-sidecar-stale
        title: MevSidecarStale
        condition: C
        for: 5m
        # Alerting on noData: a missing metric means the textfile collector
        # stopped emitting it -- either the exporter is dead or the sidecar
        # /health endpoint is unreachable. Both deserve an alert; OK would
        # silently mask both.
        noDataState: Alerting
        labels:
          severity: warning
        annotations:
          summary: "FastLane sidecar has not received a tx in >{{ alert_mev_stale_seconds }}s (likely stale mempool bind-mount inode)"
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              refId: A
              # Compute age from prometheus's own clock (immune to exporter
              # staleness) and multiply by a 1/0 mask so brand-new nodes
              # (tx_received=0) collapse to 0 (below threshold) without ever
              # producing an empty vector. Empty vector + noDataState:Alerting
              # would falsely fire on a fresh node -- the `> bool 0` form
              # preserves the series. Default label matching keeps this
              # per-instance, so a busy node can't silence a stalled neighbor.
              expr: (time() - monad_mev_last_received_timestamp) * (monad_mev_tx_received > bool 0)
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              datasource:
                type: '__expr__'
                uid: '__expr__'
          - refId: C
            datasourceUid: '__expr__'
            relativeTimeRange:
              from: 0
              to: 0
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [{{ alert_mev_stale_seconds }}]
              datasource:
                type: '__expr__'
                uid: '__expr__'
