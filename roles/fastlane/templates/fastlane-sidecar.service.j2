[Unit]
Description=FastLane MEV Sidecar (rootless)
Requires=docker.service
After=docker.service network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=30

ExecStartPre=-/usr/bin/docker rm -f fastlane-sidecar
# Refuse to start unless the mempool socket exists AND is a socket. Without
# this, `docker run -v` auto-creates a host *directory* at the bind-mount path
# if the socket is missing, which then prevents consensus from binding the
# socket on its next restart. This guard runs on every start path -- watcher,
# handler, manual `systemctl restart`, deploy redeploy -- not just the .path
# watcher's wait-loop.
ExecStartPre=/bin/sh -c '[ -S {{ monad_mempool_socket }} ] || { echo "mempool socket {{ monad_mempool_socket }} missing or not a socket; refusing to start (would corrupt bind-mount path)" >&2; exit 1; }'

ExecStart=/usr/bin/docker run --rm --name fastlane-sidecar \
  --read-only \
  --tmpfs /tmp:rw,size=64m \
  --cap-drop=ALL \
  --security-opt=no-new-privileges \
  --pids-limit=512 \
  --memory={{ fastlane_memory_limit }} \
{% if fastlane_cpu_pinning | length > 0 and fastlane_cpu_pinning_supported %}
  --cpuset-cpus={{ fastlane_cpu_pinning }} \
{% endif %}
  -v {{ monad_mempool_socket }}:/home/monad/monad-bft/mempool.sock:{{ fastlane_socket_mode }} \
  -p 127.0.0.1:{{ fastlane_sidecar_port }}:{{ fastlane_sidecar_port }} \
  {{ fastlane_sidecar_image }}@{{ fastlane_sidecar_image_digest }} \
  -network {{ monad_network_name }} \
  -log-level {{ fastlane_log_level }} \
  -monitoring-port {{ fastlane_sidecar_port }}

ExecStop=/usr/bin/docker stop fastlane-sidecar

[Install]
WantedBy=default.target
